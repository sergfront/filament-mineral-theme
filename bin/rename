#!/usr/bin/env python3
"""Rename release identity locally. Never creates repositories or publishes artifacts."""
import argparse, json, os, re, shutil, stat, subprocess, tempfile
from pathlib import Path
root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--vendor', required=True)
parser.add_argument('--package')
parser.add_argument('--email', required=True)
parser.add_argument('--dry-run', action='store_true')
args = parser.parse_args()
old = json.loads((root/'release.json').read_text())
package = args.package or old['package']
if not re.fullmatch(r'[a-z0-9]+(?:[_.-][a-z0-9]+)*', args.vendor.lower()): parser.error('Invalid Composer vendor')
if not re.fullmatch(r'[a-z0-9]+(?:[_.-][a-z0-9]+)*', package): parser.error('Invalid Composer package')
if not re.fullmatch(r'[^\s@]+@[^\s@]+\.[^\s@]+', args.email): parser.error('Invalid email')
if not args.dry_run and not shutil.which('composer'): parser.error('Composer is required to refresh the lockfile')
old_name = old['vendor'].lower()+'/'+old['package']
new_name = args.vendor.lower()+'/'+package
excluded = {'.git','vendor','node_modules','build','.phpunit.cache','.phpstan-cache','.pest'}
changes = []
for path in root.rglob('*'):
    rel = path.relative_to(root)
    if any(part in excluded for part in rel.parts) or rel.parts[:2] == ('demo','app'): continue
    if not path.is_file() or path.is_symlink() or path.name == 'release.json': continue
    if path.suffix not in {'.md', '.json', '.sh'}: continue
    try: text = path.read_text()
    except (UnicodeError, OSError): continue
    result = (text.replace(old_name,new_name)
                  .replace('`'+old['vendor']+'`', '`'+args.vendor+'`')
                  .replace('`'+old['vendor'].lower()+'`', '`'+args.vendor.lower()+'`'))
    if path.suffix == '.json':
        result = result.replace(json.dumps(old['support_email']), json.dumps(args.email))
    else:
        result = result.replace(old['support_email'],args.email)
    # Private Node metadata uses the package slug, without the Composer vendor.
    if path.name in ('package.json','package-lock.json'):
        result = result.replace('"'+old['package']+'"','"'+package+'"')
    if result != text: changes.append((path,result))
print(f'{old_name} -> {new_name}; support: {args.email}')
for path,_ in changes: print(path.relative_to(root))
if args.dry_run: raise SystemExit(0)
new = {**old,'vendor':args.vendor,'package':package,'support_email':args.email}
changes_by_path = dict(changes)
stage_parent = root / 'build'
stage_parent.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(prefix='rename-', dir=stage_parent) as stage_name:
    stage = Path(stage_name)
    (stage / 'composer.json').write_text(changes_by_path.get(root / 'composer.json', (root / 'composer.json').read_text()))
    shutil.copy2(root / 'composer.lock', stage / 'composer.lock')
    subprocess.run(['composer','update','--lock','--no-install','--no-scripts','--no-interaction'],cwd=stage,check=True)
    subprocess.run(['composer','validate','--strict'],cwd=stage,check=True)

    writes = [(path, result.encode()) for path, result in changes]
    writes.extend([(root / 'release.json', (json.dumps(new,indent=2)+'\n').encode()),
                   (root / 'composer.lock', (stage / 'composer.lock').read_bytes())])
    original = {path: path.read_bytes() for path, _ in writes}

    def replace_file(path, content):
        with tempfile.NamedTemporaryFile(dir=path.parent, prefix='.mineral-rename-', delete=False) as tmp:
            temp_path = Path(tmp.name)
            tmp.write(content)
        try:
            temp_path.chmod(stat.S_IMODE(path.stat().st_mode))
            os.replace(temp_path, path)
        finally:
            temp_path.unlink(missing_ok=True)

    written = []
    try:
        for path, content in writes:
            replace_file(path, content)
            written.append(path)
    except Exception:
        for path in reversed(written):
            replace_file(path, original[path])
        raise
print('Identity updated. Rebuild Lite and release archives; existing exports and demo/app are intentionally excluded.')
